# ─── Discord ───
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_NAME=PapiaGamerz VMS
PREFIX=!

# ─── Admin & Roles ───
# MAIN_ADMIN_ID = YOUR Discord User ID (17-20 digit number, not a role ID)
MAIN_ADMIN_ID=1210291131301101618
# VPS_USER_ROLE_ID = Role ID to assign VPS owners (0 = auto-create)
VPS_USER_ROLE_ID=0
# DEPLOY_ROLE_ID = Role ID allowed to use !deploy (0 = disabled)
DEPLOY_ROLE_ID=0

# ─── Server ───
# YOUR_SERVER_IP = Public IP users SSH to (NOT 127.0.0.1)
YOUR_SERVER_IP=YOUR.PUBLIC.IP.HERE
DEFAULT_STORAGE_POOL=default

# ─── Branding ───
BOT_VERSION=8.0-PRO
BOT_DEVELOPER=PapiaGamerz
BOT_THUMBNAIL_URL=https://i.imgur.com/Tv3clt0.jpeg
BOT_ICON_URL=https://i.imgur.com/Tv3clt0.jpeg

# ─── Expiration ───
DEFAULT_VPS_EXPIRATION_DAYS=30
EXPIRATION_WARNING_DAYS=1

# ─── Self-Service Deploy (!deploy) ───
DEPLOY_RAM=16
DEPLOY_CPU=3
DEPLOY_DISK=80
# Max VPS per user via !deploy
VPS_DEPLOY_LIMIT=2
# Global slot cap (0 = unlimited)
DEPLOY_SLOT=50

# ─── Optional MOTD ───
# HOST_MOTD=echo "Welcome to your VPS" >> /etc/motd
HOST_MOTD=
